<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="info">
    <!-- Root logger configuration -->
    <Appenders>
        <!-- Console appender configuration -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} - %p - %m%n" />
        </Console>

        <!-- File appender configuration -->
        <File name="File" fileName="logs/application.log" append="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} - %p - %m%n" />
        </File>
    </Appenders>

    <Loggers>
        <!-- Root logger level set to INFO, using Console appender -->
        <Root level="error">
            <AppenderRef ref="File" />
        </Root>

        <!-- AWS SDK logs set to DEBUG level -->
        <Logger name="software.amazon.awssdk" level="error" additivity="false">
            <AppenderRef ref="File" />
        </Logger>

        <!-- Additional AWS SDK logs set to DEBUG level -->
        <Logger name="com.amazonaws" level="error" additivity="false">
            <AppenderRef ref="File" />
        </Logger>

        <!-- Custom application logs (com.consumer) set to INFO level -->
        <Logger name="com.consumer" level="error" additivity="false">
            <AppenderRef ref="File" />
        </Logger>
    </Loggers>
</Configuration>
